@@ -0,0 +1,96 @@
+"""Readership regression tests using temporary SQLite databases only."""
+import concurrent.futures
+import sqlite3
+import uuid
+from test_news_campuses import NewsCampusTests
+
+
+class NewsViewTests(NewsCampusTests):
+    def view(self, news_id='legacy', visitor=None, campus='kindergarten'):
+        return self.client.post('/api/news/' + news_id + '/views?campus=' + campus,
+                                json={'visitorId': visitor or str(uuid.uuid4())})
+
+    def test_first_repeat_and_other_readers(self):
+        visitor = str(uuid.uuid4())
+        self.assertEqual(self.client.get('/api/news/legacy').json['viewCount'], 0)
+        for expected in [True, False, False]:
+            result = self.view(visitor=visitor)
+            self.assertEqual(result.status_code, 200)
+            self.assertEqual(result.json['counted'], expected)
+            self.assertEqual(result.json['viewCount'], 1)
+        self.assertEqual(self.view().json['viewCount'], 2)
+        self.assertEqual(self.client.get('/api/news/legacy').json['viewCount'], 2)
+        self.assertEqual(self.client.get('/api/news/').json['items'][0]['viewCount'], 2)
+
+    def test_listing_details_and_previews_do_not_count(self):
+        for _ in range(3):
+            self.client.get('/api/news/')
+            self.client.get('/api/news/legacy?campus=kindergarten')
+        self.assertEqual(self.client.get('/api/news/legacy').json['viewCount'], 0)
+
+    def test_campuses_share_readers_but_articles_do_not(self):
+        both = self.create(['kindergarten', 'afterschool'])['id']
+        visitor = str(uuid.uuid4())
+        self.assertEqual(self.view(both, visitor).json['viewCount'], 1)
+        self.assertFalse(self.view(both, visitor, 'afterschool').json['counted'])
+        self.assertEqual(self.view(visitor=visitor).json['viewCount'], 1)
+
+    def test_hidden_drafts_scheduled_missing_and_wrong_campus_do_not_count(self):
+        for status, publish_at in [('draft', '2026-01-01'), ('hidden', '2026-01-01'),
+                                   ('published', '9999-01-01')]:
+            article = self.create(['kindergarten'], status=status, publishAt=publish_at)['id']
+            self.assertEqual(self.view(article).status_code, 404)
+            self.assertEqual(self.client.get('/api/news/' + article).json['viewCount'], 0)
+        self.assertEqual(self.view('missing').status_code, 404)
+        self.assertEqual(self.view(campus='afterschool').status_code, 404)
+        self.assertEqual(self.view(campus='unknown').status_code, 400)
+
+    def test_invalid_payloads(self):
+        for payload in [None, [], {}, {'visitorId': 123}, {'visitorId': 'x'},
+                        {'visitorId': str(uuid.uuid1())}, {'visitorId': 'x' * 1000}]:
+            self.assertEqual(self.client.post('/api/news/legacy/views', json=payload).status_code, 400)
+
+    def test_counts_survive_edits_and_migration_and_delete_cleans_readers(self):
+        self.view()
+        self.client.put('/api/news/legacy', json={'title': 'Updated', 'viewCount': 999})
+        self.routes._migrate()
+        self.assertEqual(self.client.get('/api/news/legacy').json['viewCount'], 1)
+        self.client.delete('/api/news/legacy')
+        with self.routes.data_service.get_db() as conn:
+            self.assertEqual(conn.execute('SELECT COUNT(*) FROM news_readers').fetchone()[0], 0)
+
+    def test_parallel_duplicate_and_distinct_readers(self):
+        visitor = str(uuid.uuid4())
+        tokens = [visitor] * 8 + [str(uuid.uuid4()) for _ in range(8)]
+        def send(token):
+            with self.client.application.test_client() as client:
+                return client.post('/api/news/legacy/views', json={'visitorId': token}).status_code
+        with concurrent.futures.ThreadPoolExecutor(max_workers=8) as pool:
+            self.assertEqual(list(pool.map(send, tokens)), [200] * 16)
+        self.assertEqual(self.client.get('/api/news/legacy').json['viewCount'], 9)
+        with self.routes.data_service.get_db() as conn:
+            self.assertEqual(conn.execute('SELECT COUNT(*) FROM news_readers').fetchone()[0], 9)
+            self.assertNotIn(visitor, str(conn.execute('SELECT * FROM news_readers').fetchall()))
+
+    def test_existing_campus_database_is_backed_up_before_views_migration(self):
+        with self.routes.data_service.get_db() as conn:
+            conn.execute('DROP TABLE news_readers')
+            # Rebuild the table without the new column to simulate current prod.
+            columns = [row[1] for row in conn.execute('PRAGMA table_info(news)') if row[1] != 'view_count']
+            names = ', '.join(columns)
+            conn.execute('CREATE TABLE old_news AS SELECT ' + names + ' FROM news')
+            conn.execute('DROP TABLE news')
+            conn.execute('ALTER TABLE old_news RENAME TO news')
+        self.routes._migrate()
+        import glob
+        backups = glob.glob(self.routes.data_service.db_path + '.backup-before-news-views-*')
+        self.assertEqual(len(backups), 1)
+        with sqlite3.connect(backups[0]) as conn:
+            self.assertEqual(conn.execute('SELECT title FROM news').fetchone()[0], 'Legacy')
+            self.assertNotIn('view_count', [row[1] for row in conn.execute('PRAGMA table_info(news)')])
+        self.assertEqual(self.client.get('/api/news/legacy').json['viewCount'], 0)
+
+
+if __name__ == '__main__':
+    import unittest
+    unittest.main()
