+@news_bp.route('/<news_id>/views', methods=['POST'])
+def record_news_view(news_id):
+    """Count each anonymous browser once per published article across campuses."""
+    campus = request.args.get('campus')
+    if campus is not None and campus not in CAMPUSES:
+        return jsonify({'error': 'Invalid campus'}), 400
+    data = request.get_json(silent=True)
+    if not isinstance(data, dict) or not isinstance(data.get('visitorId'), str):
+        return jsonify({'error': 'visitorId must be a UUID'}), 400
+    try:
+        visitor = uuid.UUID(data['visitorId'])
+        if visitor.version != 4 or str(visitor) != data['visitorId'].lower():
+            raise ValueError('Expected canonical UUID v4')
+    except (ValueError, AttributeError):
+        return jsonify({'error': 'visitorId must be a UUID v4'}), 400
+    # Article-specific hash avoids storing browser tokens or personal details.
+    visitor_hash = hashlib.sha256((news_id + ':' + str(visitor)).encode()).hexdigest()
+    conn = data_service.get_db()
+    try:
+        # Serialize check, insert and increment: parallel requests cannot double
+        # count or race publication/deletion. The composite PK enforces uniqueness.
+        conn.execute('BEGIN IMMEDIATE')
+        r = conn.execute('SELECT * FROM news WHERE id = ?', (news_id,)).fetchone()
+        if (not r or r['status'] != 'published' or _is_future_publish_at(r['publish_at'])
+                or (campus and campus not in _row_campuses(r))):
+            return jsonify({'error': 'News not available'}), 404
+        inserted = conn.execute('''INSERT OR IGNORE INTO news_readers
+            (news_id, visitor_hash, first_viewed_at) VALUES (?, ?, ?)''',
+            (news_id, visitor_hash, datetime.now(timezone.utc).isoformat())).rowcount
+        if inserted:
+            conn.execute('UPDATE news SET view_count = view_count + 1 WHERE id = ?', (news_id,))
+        count = conn.execute('SELECT view_count FROM news WHERE id = ?', (news_id,)).fetchone()[0]
+        conn.commit()
+        response = jsonify({'id': news_id, 'viewCount': count, 'counted': bool(inserted)})
+        response.headers['Cache-Control'] = 'no-store'
+        return response
+    finally:
+        conn.close()
+
 
