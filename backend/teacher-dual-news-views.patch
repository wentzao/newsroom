+function formatCount(value) {
+    return Number.isSafeInteger(value) && value >= 0 ? value.toLocaleString('zh-TW') : '—';
+}
+
+export default function NewsViewStats({ item }) {
+    const available = item.viewMetricsVersion === 2;
+    const detail = available && Number.isSafeInteger(item.viewOffset)
+        ? `起始值 ${formatCount(item.viewOffset)} ＋ 實際瀏覽 ${formatCount(item.actualViewCount)} 次。實際人數依瀏覽器去重，重整不增加；不同裝置分開計算。`
+        : '雙統計尚未啟用，或教師身分尚未驗證。';
+    return <div className="news-view-stats" title={detail}>
+        <div><span>對外瀏覽</span><strong data-view-metric="public">{available ? formatCount(item.viewCount) : '—'}</strong><span>次</span></div>
+        <div><span>實際人數</span><strong data-view-metric="unique">{available ? formatCount(item.uniqueViewCount) : '—'}</strong><span>人</span></div>
+    </div>;
+}
